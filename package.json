{
  "name": "classroom-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "check": "node scripts/check-build.mjs",
    "typecheck": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "og-image": "node scripts/og-image.mjs",
    "llms": "node scripts/llms.mjs",
    "db:migrate:local": "wrangler d1 migrations apply classroom-labs --local",
    "db:migrate:remote": "wrangler d1 migrations apply classroom-labs --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
