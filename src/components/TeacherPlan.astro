---
// The Teacher plan section: a short pitch and the waitlist form (docs/waitlist-contract.md).
// The form posts to the same-origin API. Without JavaScript it is a normal form post; the API answers with a
// 303 back to this page with ?waitlist=<result>, and the Worker reveals the matching message (src/notice.ts).
// With JavaScript, src/scripts/waitlist.ts sends it with fetch and shows the result in place.
// The form renders only when PUBLIC_TURNSTILE_SITE_KEY is set (the API needs a Turnstile token).
import { site } from '../lib/site.mjs';
import { turnstileSiteKey, waitlistEnabled } from '../lib/env';
import { MESSAGES } from '../lib/waitlist.mjs';

const returnUrl = new URL(`${Astro.url.pathname}#teacher-plan`, site.url).href;
const interests = [
  ['class_results', 'Class results without student accounts'],
  ['editable_worksheets', 'Editable worksheets'],
  ['answer_keys', 'Editable answer keys'],
  ['quiz_banks', 'Quiz banks'],
  ['all_labs_licence', 'One license for all the labs'],
];
---
<section class="plan" id="teacher-plan" aria-labelledby="teacher-plan-heading">
  <div class="wrap plan-grid">
    <div class="plan-pitch">
      <span class="eyebrow">Teacher plan</span>
      <h2 id="teacher-plan-heading">A plan for teachers and schools is in the works</h2>
      <p>Every lab stays free for students, with no sign-up. Alongside that, we’re planning a paid plan for teachers and schools, with things like:</p>
      <ul class="plan-list">
        <li>class results without student accounts</li>
        <li>editable worksheets and answer keys</li>
        <li>quiz banks</li>
        <li>one license for all the labs</li>
      </ul>
      <p>Nothing is decided yet. Join the list to be asked first and to help shape what it includes.</p>
      {!waitlistEnabled && <p class="note">The sign-up form opens here soon.</p>}
    </div>
    {waitlistEnabled && (
      <div class="plan-panel">
        <div class="plan-status" role="status" aria-live="polite" tabindex="-1" data-waitlist-status>
          {Object.entries(MESSAGES).map(([code, text]) => (
            <p class={code === 'ok' ? 'msg msg-ok' : 'msg msg-error'} data-waitlist-message={code} hidden>{text}</p>
          ))}
        </div>
        <form class="plan-form" method="post" action={site.waitlistEndpoint} data-waitlist-form>
          <h3 class="form-title">Join the teacher plan list</h3>
          <div class="field">
            <label for="wl-email">Email</label>
            <input id="wl-email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" />
          </div>
          <div class="field">
            <label for="wl-role">I am a</label>
            <select id="wl-role" name="role" required>
              <option value="">Choose one</option>
              <option value="teacher">Teacher</option>
              <option value="school_leader">School leader</option>
              <option value="district">District staff</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="wl-subjects">Subjects you teach <span class="optional">(optional)</span></label>
              <input id="wl-subjects" name="subjects" type="text" maxlength="200" autocomplete="off" />
            </div>
            <div class="field">
              <label for="wl-grades">Grades <span class="optional">(optional)</span></label>
              <input id="wl-grades" name="grades" type="text" maxlength="100" autocomplete="off" placeholder="e.g. 6–8" />
            </div>
          </div>
          <fieldset class="field">
            <legend>What would help you most? <span class="optional">(optional)</span></legend>
            {interests.map(([value, label]) => (
              <label class="check"><input type="checkbox" name="interests" value={value} /> <span>{label}</span></label>
            ))}
          </fieldset>
          <fieldset class="field">
            <legend>Does your school buy software for teachers?</legend>
            <div class="radios">
              <label class="check"><input type="radio" name="school_buys" value="yes" required /> <span>Yes</span></label>
              <label class="check"><input type="radio" name="school_buys" value="no" /> <span>No</span></label>
              <label class="check"><input type="radio" name="school_buys" value="not_sure" /> <span>Not sure</span></label>
            </div>
          </fieldset>
          <label class="check consent"><input type="checkbox" name="consent" value="yes" required /> <span>I agree that Classroom Labs may store my answers and email me about the teacher plan. See the <a href="/privacy/#waitlist">privacy policy</a>.</span></label>
          <div class="hp" aria-hidden="true">
            <label for="wl-website">Leave this empty</label>
            <input id="wl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="site" value={site.hostname} />
          <input type="hidden" name="source" value="hub" />
          <input type="hidden" name="return" value={returnUrl} />
          <div class="turnstile-slot"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-action="waitlist"></div></div>
          <button class="btn primary" type="submit" data-waitlist-submit>Join the list</button>
          <p class="form-note">We only use your email for the teacher plan. You can ask us to delete it at any time.</p>
        </form>
      </div>
    )}
  </div>
</section>
{waitlistEnabled && (
  <script>
    import { initWaitlist } from '../scripts/waitlist';
    initWaitlist();
  </script>
)}

<style>
  .plan { background: var(--board); color: var(--board-ink); padding: 56px 0; scroll-margin-top: 8px; }
  .plan :global(.eyebrow) { color: var(--board-link); }
  .plan-grid { display: grid; gap: 28px 48px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; }
  @media (max-width: 860px) { .plan-grid { grid-template-columns: minmax(0, 1fr); } }
  .plan-pitch h2 { color: var(--board-ink); }
  .plan-pitch p, .plan-list { color: var(--board-muted); font-size: 1.08rem; }
  .plan-list li::marker { color: var(--board-link); }
  .plan-pitch .note { color: var(--ink); }
  .plan-panel { background: var(--card); color: var(--ink); border-radius: var(--radius); padding: 24px; box-shadow: 6px 6px 0 var(--marigold); }
  .form-title { font-size: 1.3rem; }
  .field { margin: 0 0 16px; padding: 0; border: 0; min-width: 0; }
  .field-row { display: grid; gap: 0 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  label, legend { font-weight: 700; }
  .field > label { display: block; margin-bottom: 4px; }
  legend { margin-bottom: 4px; padding: 0; }
  .optional { font-weight: 400; color: var(--muted); }
  input[type='email'], input[type='text'], select { display: block; width: 100%; min-height: 46px; padding: 8px 12px; border: 2px solid var(--field-line); border-radius: 8px; background: var(--field); color: var(--ink); }
  input[aria-invalid='true'] { border-color: var(--error-ink); }
  .check { display: flex; align-items: flex-start; gap: 10px; min-height: 40px; padding: 6px 0; font-weight: 400; cursor: pointer; }
  .check input { flex: none; width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--ink-2); }
  .radios { display: flex; flex-wrap: wrap; gap: 0 22px; }
  .consent { margin: 4px 0 14px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  /* Turnstile's widget is 300 × 65 px: the space is kept from the start so nothing moves when it loads. */
  .turnstile-slot { min-height: 65px; margin: 0 0 14px; }
  .form-note { margin: 12px 0 0; font-size: .92rem; color: var(--muted); }
  .plan-status:focus { outline: none; }
  .plan-status:focus-visible { outline: 3px solid var(--ink-2); }
  .msg { margin: 0 0 16px; padding: 12px 14px; border-radius: 8px; font-weight: 700; }
  .msg-ok { background: var(--ok-bg); color: var(--ok-ink); }
  .msg-error { background: var(--error-bg); color: var(--error-ink); }
  @media (max-width: 400px) {
    .plan-panel { margin: 0 -16px; padding: 20px 14px; border-radius: 0; box-shadow: 0 6px 0 var(--marigold); }
  }
</style>
