---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page has moved or never existed. Try the free labs for science, math, spreadsheets, coding and reading, the teachers page, or the home page." noindex>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">404</span>
      <h1>This page is not on the timetable</h1>
      <p class="lede">We couldn’t find that page. It may have moved, or the link may be mistyped.</p>
      <div class="actions">
        <a class="btn primary" href="/#labs">The labs</a>
        <a class="btn" href="/teachers/">For teachers</a>
        <a class="btn" href="/">Home</a>
      </div>
    </div>
  </div>
</Layout>
