# Build-time settings for the hub pages. Copy to .env for local builds; set the same names as build
# variables in Cloudflare Workers Builds (Settings -> Build -> Variables and secrets) for production.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty: no Google tag, no cookies, no cookie banner.
PUBLIC_GA_ID=
# Turnstile site key (public) for the waitlist form. Empty: the form is not shown.
# Local testing: 1x00000000000000000000AA always passes (with the matching test secret in .dev.vars).
PUBLIC_TURNSTILE_SITE_KEY=
# The contact address shown on the site (questions, and requests to delete a signup). Empty: not shown.
PUBLIC_CONTACT_EMAIL=
